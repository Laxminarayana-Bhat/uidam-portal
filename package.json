{
  "name": "uidam-web-admin-portal",
  "version": "1.0.0",
  "type": "module",
  "description": "Modern web admin portal for UIDAM (User Identity and Access Management) system",
  "author": "UIDAM Team",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=Layout.test.tsx --testPathIgnorePatterns=apiUtils.test.ts --testPathIgnorePatterns=auth.service.test.ts",
    "test:ci": "jest --ci",
    "test:e2e": "cypress open",
    "test:e2e:headless": "cypress run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "prelicense:check": "node scripts/download-dash-licenses.js",
    "license:check": "dash-licenses-wrapper --inputFile=package-lock.json --summary=DEPENDENCIES --timeout=500",
    "prelicense:check:review": "node scripts/download-dash-licenses.js",
    "license:check:review": "dash-licenses-wrapper --inputFile=package-lock.json --review --project=automotive.ecsp --summary=DEPENDENCIES --timeout=500"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^3.3.2",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^6.18.0",
    "@mui/x-date-pickers": "^6.18.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@tanstack/react-query": "^5.14.2",
    "@tanstack/react-query-devtools": "^5.14.2",
    "axios": "1.20.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.6",
    "lodash": "4.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.8.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@eclipse-dash/nodejs-wrapper": "^0.0.1",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.6",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.202",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.1.1",
    "storybook": "8.6.14",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "6.4.3"
  },
  "overrides": {
    "flatted": ">=3.4.2",
    "ajv@6": "6.14.0",
    "glob@7": {
      "minimatch": "~3.1.5"
    },
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "browserslist": "4.28.7",
    "compression": "1.8.2",
    "esbuild": "0.25.0",
    "extract-zip": "2.0.1",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "node-dir": {
      "minimatch": "~3.1.5"
    },
    "filelist": {
      "minimatch": "~5.1.8"
    },
    "minimatch@9": "~9.0.7",
    "qs": ">=6.14.2",
    "tar": ">=7.5.21",
    "handlebars": ">=4.7.9",
    "path-to-regexp": "0.1.13",
    "defu": ">=6.1.5",
    "picomatch": ">=4.0.4",
    "rollup": ">=4.58.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  }
}
